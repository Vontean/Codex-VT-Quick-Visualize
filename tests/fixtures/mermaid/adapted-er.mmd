erDiagram
  direction LR
  AUTHOR[作者] {
    uuid id PK "作者标识"
    string name "显示名称"
    string email UK "联系邮箱"
  }
  CONTENT[内容] {
    uuid id PK "内容标识"
    uuid author_id FK "所属作者"
    string title "内容标题"
    string status "发布状态"
    datetime published_at "发布时间"
  }
  VERSION[版本] {
    uuid id PK "版本标识"
    uuid content_id FK "所属内容"
    int revision "修订序号"
    text body "正文"
  }
  CONTENT_TAG[内容标签] {
    uuid content_id PK, FK "所属内容"
    uuid tag_id PK, FK "所属标签"
  }
  TAG[标签] {
    uuid id PK "标签标识"
    string name UK "标签名称"
  }
  AUTHOR ||..o{ CONTENT : 创作
  CONTENT ||--|{ VERSION : 包含
  CONTENT ||--o{ CONTENT_TAG : 标记
  TAG ||--o{ CONTENT_TAG : 关联
